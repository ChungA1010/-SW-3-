APP_NAME=Effect Analyzer API
APP_ENV=development
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=80
TEMP_FILE_TTL_HOURS=12

# NOTE: Change these if you move the project.
PROJECT_ROOT=
WEIGHTS_PATH=

# NOTE: Demucs usually produces "other" instead of a dedicated guitar stem.
# If your Demucs model produces "guitar.wav", put guitar first.
DEMUCS_MODEL=htdemucs
DEMUCS_STEM_CANDIDATES=guitar,other
DEMUCS_DEVICE=cpu

# NOTE: These defaults match the existing 09_gru model training setup.
MODEL_SAMPLE_RATE=32000
MODEL_SEGMENT_SECONDS=3.0
MODEL_N_MFCC=20
MODEL_HOP_LENGTH=256

